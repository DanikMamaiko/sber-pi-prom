APP_NAME=SberPI PI Cycle MVP
APP_ENV=production
SBERPI_VERSION=local
SBERPI_FRONTEND_PORT=18080

# PostgreSQL is external to this Compose project. Replace every placeholder.
DATABASE_URL=postgresql+asyncpg://sberpi_app:CHANGE_ME@DB_HOST:5432/sberpi
AUDIT_ENABLED=true
# Empty means that audit events use the same database and credentials.
AUDIT_DATABASE_URL=

# Public address of the installation. For the temporary IP test use http://SERVER_IP.
CORS_ORIGINS=https://safe.pip.sigma-belpsb.by

# Local authentication is for the pilot only. Do not retain example credentials.
AUTH_PROVIDER=local
AUTH_TEST_USERS=admin:CHANGE_ME:admin

SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
SESSION_TTL_MINUTES=60
SESSION_COOKIE_NAME=sberpi_session
SESSION_COOKIE_SECURE=true

AUDIT_SOURCE_SERVICE=sberpi-api
AUDIT_HOST_IP=
AUDIT_TRUSTED_PROXY_NETWORKS=172.16.0.0/12
AUDIT_CONNECT_TIMEOUT_SECONDS=3
AUDIT_RETRY_SECONDS=30

AD_GROUP_ADMIN=SBERPI_ADMIN
AD_GROUP_PLANNING_EDITOR=SBERPI_PLANNING_EDITOR
AD_GROUP_BUSINESS_VIEWER=SBERPI_BUSINESS_VIEWER

LDAP_URL=ldaps://ad.company.local:636
LDAP_BASE_DN=DC=company,DC=local
LDAP_USER_SEARCH_BASE=OU=Users,DC=company,DC=local
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_GROUP_SEARCH_BASE=OU=Groups,DC=company,DC=local
LDAP_GROUP_FILTER=(member={user_dn})
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USE_TLS=true
