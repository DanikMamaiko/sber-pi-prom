APP_NAME=SberPI PI Cycle MVP
APP_ENV=production
SBERPI_VERSION=local
SBERPI_FRONTEND_PORT=18080

# PostgreSQL is external to this Compose project. Replace every placeholder.
DATABASE_URL=postgresql+asyncpg://sberpi_app:CHANGE_ME@DB_HOST:5432/sberpi
AUDIT_ENABLED=true
# Empty means that audit events use the same database and credentials.
AUDIT_DATABASE_URL=

# Public address of the installation. For the temporary IP test use http://SERVER_IP.
CORS_ORIGINS=https://safe.pip.sigma-belpsb.by

# LDAP authentication for the IFT contour. Bind credentials must stay outside Git.
AUTH_PROVIDER=ldap
AUTH_TEST_USERS=

SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
SESSION_TTL_MINUTES=60
SESSION_COOKIE_NAME=sberpi_session
SESSION_COOKIE_SECURE=true

# Jira SW IFT. Keep credentials out of Git and replace them in the deployment secret.
JIRA_ENABLED=true
JIRA_BASE_URL=https://jira-apptst-ift.sigma-belpsb.by/jira
JIRA_USERNAME=CHANGE_ME
JIRA_PASSWORD=CHANGE_ME
JIRA_VERIFY_SSL=true
JIRA_CA_BUNDLE=
JIRA_TIMEOUT_SECONDS=10
JIRA_MAX_CONCURRENT_REQUESTS=20
JIRA_MAX_QUEUE_SIZE=50
JIRA_QUEUE_TIMEOUT_SECONDS=5
JIRA_WORKDAY_HOURS=8

AUDIT_SOURCE_SERVICE=sberpi-api
AUDIT_HOST_IP=
AUDIT_TRUSTED_PROXY_NETWORKS=172.16.0.0/12
AUDIT_CONNECT_TIMEOUT_SECONDS=3
AUDIT_RETRY_SECONDS=30
# Enabled by docker-compose.siem.yml after provisioning the host log directory.
SIEM_AUDIT_LOG_PATH=
# Direct UDP syslog; keep SIEM_AUDIT_LOG_PATH empty in this mode.
SIEM_SYSLOG_ENABLED=false
SIEM_SYSLOG_TARGET=
SIEM_SYSLOG_PORT=514
SIEM_SYSLOG_PROTOCOL=udp
SIEM_SYSLOG_HOSTNAME=sberpi-sigma

AD_GROUP_ADMIN=CN=SberPI-Admins,OU=SberPI,OU=Groups for soft access,OU=Groups,OU=Tech,DC=sigma-belpsb,DC=by
AD_GROUP_PLANNING_EDITOR=CN=SberPI-PlanningEditors,OU=SberPI,OU=Groups for soft access,OU=Groups,OU=Tech,DC=sigma-belpsb,DC=by
AD_GROUP_BUSINESS_VIEWER=CN=SberPI-BusinessViewers,OU=SberPI,OU=Groups for soft access,OU=Groups,OU=Tech,DC=sigma-belpsb,DC=by
AD_GROUP_VIEWER=CN=SberPI-Viewers,OU=SberPI,OU=Groups for soft access,OU=Groups,OU=Tech,DC=sigma-belpsb,DC=by

LDAP_URL=ldap://sigma-belpsb.by:389
LDAP_BASE_DN=DC=sigma-belpsb,DC=by
LDAP_USER_SEARCH_BASE=DC=sigma-belpsb,DC=by
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_GROUP_SEARCH_BASE=OU=Groups,OU=Tech,DC=sigma-belpsb,DC=by
LDAP_GROUP_FILTER=(member={user_dn})
LDAP_BIND_DN=CHANGE_ME
LDAP_BIND_PASSWORD=CHANGE_ME
LDAP_USE_TLS=false
LDAP_CONNECT_TIMEOUT_SECONDS=5
