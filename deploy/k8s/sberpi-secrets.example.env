# Copy to sberpi.secrets.env, replace placeholders and never add that file to Git.
DATABASE_URL=postgresql+asyncpg://sberpi_app:CHANGE_ME@DB_HOST:5432/sberpi
AUDIT_DATABASE_URL=
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
AUTH_TEST_USERS=
JIRA_USERNAME=CHANGE_ME_IFT_JIRA_SERVICE_USER
JIRA_PASSWORD=CHANGE_ME_IFT_JIRA_PASSWORD
LDAP_BIND_DN=CHANGE_ME_IFT_LDAP_SERVICE_USER
LDAP_BIND_PASSWORD=CHANGE_ME_IFT_LDAP_PASSWORD
