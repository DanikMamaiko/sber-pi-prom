FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY backend/requirements.txt /app/requirements.txt
ARG LOCAL_MIRROR_ARGS
RUN python -m pip install $LOCAL_MIRROR_ARGS --no-cache-dir --upgrade pip==26.2.1 \
    && python -m pip install $LOCAL_MIRROR_ARGS --no-cache-dir -r /app/requirements.txt

COPY backend/app /app/app
COPY backend/alembic.ini /app/alembic.ini
COPY backend/alembic /app/alembic
COPY backend/audit_alembic.ini /app/audit_alembic.ini
COPY backend/audit_alembic /app/audit_alembic

RUN groupadd --gid 10001 sberpi \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin sberpi

USER 10001:10001

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=3)"]

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
