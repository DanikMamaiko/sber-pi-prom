APP_NAME=SberPI PI Cycle MVP
APP_ENV=local
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql+asyncpg://sberpi:CHANGE_ME_DB_PASSWORD@db:5432/sberpi
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Авторизация всегда включена. На первом этапе используется local provider.
AUTH_PROVIDER=local
AUTH_TEST_USERS=admin:CHANGE_ME_ADMIN_PASSWORD:admin,editor:CHANGE_ME_EDITOR_PASSWORD:planning_editor,po_itl:CHANGE_ME_POITL_PASSWORD:planning_editor,pm:CHANGE_ME_PM_PASSWORD:business_viewer,user:CHANGE_ME_USER_PASSWORD:viewer

# Сессия истекает ровно через 60 минут и не продлевается активностью.
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
SESSION_TTL_MINUTES=60
SESSION_COOKIE_NAME=sberpi_session
# Для HTTPS-контура обязательно true.
SESSION_COOKIE_SECURE=false

# Jira SW IFT. Credentials must be supplied only through a local secret/env file.
JIRA_ENABLED=false
JIRA_BASE_URL=https://jira-apptst-ift.sigma-belpsb.by/jira
JIRA_USERNAME=
JIRA_PASSWORD=
JIRA_VERIFY_SSL=true
# Optional path to the corporate CA certificate inside the API container.
JIRA_CA_BUNDLE=
JIRA_TIMEOUT_SECONDS=10
JIRA_WORKDAY_HOURS=8

# Security audit is stored in the same PostgreSQL database by default.
AUDIT_ENABLED=true
# Set only when a legacy deployment intentionally uses a separate audit database.
AUDIT_DATABASE_URL=
AUDIT_SOURCE_SERVICE=sberpi-api
# Optional explicit application host IP. If empty, the container resolves its own IP.
AUDIT_HOST_IP=
# Only these proxy CIDRs may supply X-Forwarded-For (comma-separated).
AUDIT_TRUSTED_PROXY_NETWORKS=
AUDIT_CONNECT_TIMEOUT_SECONDS=3
AUDIT_RETRY_SECONDS=30

# Прямое членство в группах Active Directory определяет роли приложения.
AD_GROUP_ADMIN=CN=SberPI-Admins,OU=SberPI,OU=Groups for soft access,OU=Groups,OU=Tech,DC=sigma-belpsb,DC=by
AD_GROUP_PLANNING_EDITOR=CN=SberPI-PlanningEditors,OU=SberPI,OU=Groups for soft access,OU=Groups,OU=Tech,DC=sigma-belpsb,DC=by
AD_GROUP_BUSINESS_VIEWER=CN=SberPI-BusinessViewers,OU=SberPI,OU=Groups for soft access,OU=Groups,OU=Tech,DC=sigma-belpsb,DC=by
AD_GROUP_VIEWER=CN=SberPI-Viewers,OU=SberPI,OU=Groups for soft access,OU=Groups,OU=Tech,DC=sigma-belpsb,DC=by

# LDAP/Active Directory IFT. LDAP_USE_TLS=false intentionally matches the existing corporate example.
LDAP_URL=ldap://sigma-belpsb.by:389
LDAP_BASE_DN=DC=sigma-belpsb,DC=by
LDAP_USER_SEARCH_BASE=DC=sigma-belpsb,DC=by
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_GROUP_SEARCH_BASE=OU=Groups,OU=Tech,DC=sigma-belpsb,DC=by
LDAP_GROUP_FILTER=(member={user_dn})
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USE_TLS=false
LDAP_CONNECT_TIMEOUT_SECONDS=5
