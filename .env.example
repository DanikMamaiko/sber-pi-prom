APP_NAME=SberPI PI Cycle MVP
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://sberpi:sberpi@db:5432/sberpi
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Авторизация всегда включена. На первом этапе используется local provider.
AUTH_PROVIDER=local
AUTH_TEST_USERS=admin:admin123:admin,editor:editor123:planning_editor,pm:pm123:business_viewer,user:user123:viewer

# Сессия истекает ровно через 60 минут и не продлевается активностью.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_MINUTES=60
SESSION_COOKIE_NAME=sberpi_session
# Для HTTPS-контура обязательно true.
SESSION_COOKIE_SECURE=false

# Будущий маппинг групп Active Directory на роли приложения.
AD_GROUP_ADMIN=SBERPI_ADMIN
AD_GROUP_PLANNING_EDITOR=SBERPI_PLANNING_EDITOR
AD_GROUP_BUSINESS_VIEWER=SBERPI_BUSINESS_VIEWER

# Каркас настроек будущего LDAP/Active Directory provider.
LDAP_URL=ldaps://ad.company.local:636
LDAP_BASE_DN=DC=company,DC=local
LDAP_USER_SEARCH_BASE=OU=Users,DC=company,DC=local
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_GROUP_SEARCH_BASE=OU=Groups,DC=company,DC=local
LDAP_GROUP_FILTER=(member={user_dn})
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USE_TLS=true
